# Copy to .env and set a unique SECRET_KEY before local use.
DATABASE_URL=sqlite:///./professor_stocks.db
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:5173

# Public PSX Lens data is delayed, not real-time. Confirm terms before
# production redistribution or commercial use. Use "demo" only for offline UI work.
DATA_PROVIDER=psxlens
PSXLENS_API_BASE_URL=https://api.psxlens.com

# Shared market-data cache and provider request policy (seconds, except retries).
FRONTEND_POLL_INTERVAL=30
QUOTE_CACHE_TTL=60
FRESHNESS_CACHE_TTL=300
HISTORICAL_CACHE_TTL=3600
DIVIDEND_CACHE_TTL=86400
FINANCIAL_CACHE_TTL=86400
SECTOR_CACHE_TTL=300
API_TIMEOUT=5
MAX_RETRIES=2

# Reserved for a future licensed provider adapter; not currently consumed.
CAPITAL_STAKE_WS_URL=
CAPITAL_STAKE_API_TOKEN=
