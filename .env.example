# Backend settings (copy to backend/.env for local development)
DATABASE_URL=sqlite:///./professor_stocks.db
SECRET_KEY=replace-with-a-long-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:5173
DATA_PROVIDER=demo

# Shared market data caching & polling configuration (seconds, except retries)
FRONTEND_POLL_INTERVAL=30
QUOTE_CACHE_TTL=60
FRESHNESS_CACHE_TTL=300
HISTORICAL_CACHE_TTL=3600
DIVIDEND_CACHE_TTL=86400
FINANCIAL_CACHE_TTL=86400
SECTOR_CACHE_TTL=300
API_TIMEOUT=5
MAX_RETRIES=2

# PSX Lens delayed data provider (disabled until credentials configured)
PSXLENS_API_BASE_URL=
PSXLENS_API_KEY=
PSXLENS_API_KEY_HEADER=Authorization
PSXLENS_API_KEY_SCHEME=Bearer
PSXLENS_FRESHNESS_PATH=
PSXLENS_FRESHNESS_TIMESTAMP_FIELD=
PSXLENS_QUOTES_PATH=

# Capital Stake WebSocket adapter (disabled until credentials configured)
CAPITAL_STAKE_WS_URL=
CAPITAL_STAKE_API_TOKEN=

# Frontend settings (copy to frontend/.env.local if needed)
VITE_API_URL=http://localhost:8000/api
VITE_FRONTEND_POLL_INTERVAL=30
